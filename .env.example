# Copy to .env and fill in. Never commit .env.
#
# Non-secret parameters (dwell, coach factor, traffic windows, fleet, etc.) live in
# src/config.js — edit that file instead of adding variables here.

# ---- Mode -------------------------------------------------------------------
# MOCK=true  -> adapters never hit the network; they read from fixtures/ and cache/ only
MOCK=false
LOG_LEVEL=info

# ---- External API keys & credentials ----------------------------------------
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=
BODS_API_KEY=
# Traveline National Dataset (Scottish-registered operators): FTP credentials from travelinedata.org.uk.
# Download S.zip with:  curl --disable-epsv -u "$TNDS_USERNAME:$TNDS_PASSWORD" -o data/tnds/S.zip ftp://ftp.tnds.basemap.co.uk/S.zip
TNDS_USERNAME=
TNDS_PASSWORD=
